// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "agent": {
    "auto_compact": {
      "threshold": "70%"
    },
    "default_profile": "ask",
    "default_model": {
      "effort": "high",
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "enable_thinking": true
    },
    "favorite_models": [],
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash-latest",
      "enable_thinking": false
    },
    "model_parameters": [],
    "sandbox_permissions": {
      "network_hosts": [
        "github.com",
        "*.github.com",
        "raw.githubusercontent.com"
      ]
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "default": "confirm",
          "always_allow": [
            {
              "pattern": "^bun\\b"
            },
            {
              "pattern": "^bunx\\b"
            },
            {
              "pattern": "^composer\\b"
            },
            {
              "pattern": "^docker\\b"
            },
            {
              "pattern": "^git\\b"
            },
            {
              "pattern": "^echo\\b"
            },
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^gh\\b"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^node\\b"
            },
            {
              "pattern": "^npm\\b"
            },
            {
              "pattern": "^npx\\b"
            },
            {
              "pattern": "^nub\\b"
            },
            {
              "pattern": "^php\\b"
            },
            {
              "pattern": "^pnpm\\b"
            },
            {
              "pattern": "^pnpx\\b"
            },
            {
              "pattern": "^shasum\\b"
            },
            {
              "pattern": "^tail\\b"
            },
            {
              "pattern": "^ls\\b"
            },
            {
              "pattern": "^cat\\b"
            },
            {
              "pattern": "^sed\\b"
            },
            {
              "pattern": "^ps\\s+aux(\\s|$)"
            },
            {
              "pattern": "^lsof\\b"
            },
            {
              "pattern": "^log\\s+show(\\s|$)"
            }
          ]
        },
      }
    },
  },
  "agent_servers": {
    "OpenCode": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
    },
    "KiloCode": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "custom",
      "command": "kilo",
      "args": ["acp"],
    },
  },
  "context_servers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "context-mode": {
      "command": "npx",
      "args": ["-y", "context-mode@latest"]
    },
    "dbx": {
      "command": "npx",
      "args": ["-y", "@dbx-app/mcp-server"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    }
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "base_keymap": "VSCode",
  "use_smartcase_search": true,
  "buffer_font_family": "FiraCode Nerd Font Propo",
  "buffer_font_size": 14.0,
  "ui_font_family": "FiraCode Nerd Font",
  "ui_font_size": 15.0,
  "icon_theme": "Catppuccin Mocha",
  "file_types": {
    "Nginx": [
      "*/nginx/**.conf"
    ],
    "env": [
      ".env",
      ".env.*"
    ],
    "tmux": [
      ".tmux.conf",
      "tmux.conf"
    ]
  },
  "git_panel": {
    "file_icons": true,
  },
  "languages": {
    "Blade": {
      "document_symbols": "on",
      "language_servers": ["laravel", "!phpantom", "!intelephense", "!phptools", "!phpactor", "..."],
      "semantic_tokens": "combined"
    },
    "PHP": {
      "document_symbols": "on",
      "language_servers": ["phpantom", "!laravel", "!intelephense", "!phptools", "!phpactor", "..."]
    },
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "oxfmt": {},
    "oxlint": {},
    "eslint": {},
    "astro-language-server": {},
    "laravel": {},
    "phpantom": {},
    "svelte-language-server": {},
    "vue-language-server": {},
    "tailwindcss-language-server": {},
    "typescript-language-server": {},
    "vtsls": {
      "settings": {
        // Add vue.js integration
        // See https://github.com/zed-extensions/vue/issues/6#issuecomment-2739514942
        "vtsls": {
          "experimental": {
            // https://github.com/zed-industries/zed/issues/13317#issuecomment-2646080375
            "maxInlayHintLength": 25
          },
          // "tsserver": {
          //   "globalPlugins": [
          //     {
          //       "name": "@vue/typescript-plugin",
          //       "location": "/opt/homebrew/lib/node_modules",
          //       "enableForWorkspaceTypeScriptVersions": true
          //     }
          //   ]
          // }
        },
        // For TypeScript:
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 4096
          }
        },
        // For JavaScript:
        "javascript": {
          "tsserver": {
            "maxTsServerMemory": 4096
          }
        }
      }
    },
    "json-language-server": {
      "settings": {
        "json": {
          "schemas": [
            {
              "fileMatch": [".gemini/settings.json", "gemini/settings.json"],
              "url": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/schemas/settings.schema.json"
            },
            {
              "fileMatch": [".devcontainer/*/devcontainer.json", ".devcontainer/devcontainer.json", ".devcontainer.json"],
              "url": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.base.schema.json"
            },
            {
              "fileMatch": ["*/composer.json", ".composer.json"],
              "url": "https://getcomposer.org/schema.json"
            },
            {
              "fileMatch": ["deno.json", "deno.jsonc"],
              "url": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json"
            }
          ]
        }
      }
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemas": {}
        }
      }
    },
    "lua-language-server": {},
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "ssh_connections": [
    {
      "host": "office.lan",
      "nickname": "Office Root",
      "username": "root",
      "args": [
        "-i",
        "~/.ssh/id_rsa"
      ],
      "projects": [
        {
          "paths": [
            "/etc/pve"
          ]
        }
      ]
    },
    {
      "host": "office.lan",
      "nickname": "Office Admin",
      "username": "admin",
      "args": [],
      "projects": [
        {
          "paths": [
            "~"
          ]
        }
      ]
    },
    {
      "host": "office.lan",
      "nickname": "Office Fery",
      "username": "fery",
      "args": [],
      "projects": [
        {
          "paths": [
            "~"
          ]
        }
      ]
    },
    {
      "host": "internal.lan",
      "nickname": "Internal Admin",
      "args": [],
      "projects": [
        {
          "paths": [
            "~",
            "/opt/stacks"
          ]
        }
      ]
    },
    {
      "host": "home.lan",
      "nickname": "Home Admin",
      "args": [],
      "projects": [
        {
          "paths": [
            "~",
            "/opt/stacks"
          ]
        }
      ]
    },
    {
      "host": "staging-01",
      "args": [],
      "projects": [
        {
          "paths": [
            "~/containers",
            "/opt/stacks",
          ]
        }
      ]
    },
    {
      "host": "staging-02",
      "args": [],
      "projects": [
        {
          "paths": [
            "~"
          ]
        }
      ]
    },
    {
      "host": "hostinger-b1",
      "args": [],
      "projects": [
        {
          "paths": [
            "~/domains"
          ]
        }
      ]
    }
  ],
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true
  },
  "wrap_guides": [
    80,
    100,
    120
  ],
}
