// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "auto_compact": {
      "threshold": "90%"
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash-0731",
      "enable_thinking": true
    },
    "favorite_models": [],
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "minimax/minimax-m3:free",
      "enable_thinking": false
    },
    "model_parameters": [],
    "sandbox_permissions": {
      "network_hosts": [
        "github.com",
        "api.github.com"
      ]
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\b"
            },
            {
              "pattern": "^echo\\b"
            }
          ]
        },
        "fetch": {
          "default": "allow"
        }
      }
    },
  },
  "agent_servers": {
    "OpenCode": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
    },
    "KiloCode": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "custom",
      "command": "kilo",
      "args": ["acp"],
    },
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "base_keymap": "VSCode",
  "use_smartcase_search": true,
  "buffer_font_family": "FiraCode Nerd Font Propo",
  "buffer_font_size": 14.0,
  "ui_font_family": "FiraCode Nerd Font",
  "ui_font_size": 15.0,
  "icon_theme": "Catppuccin Mocha",
  "file_types": {
    "Nginx": [
      "*/nginx/**.conf"
    ],
    "env": [
      ".env",
      ".env.*"
    ],
    "tmux": [
      ".tmux.conf",
      "tmux.conf"
    ]
  },
  "git_panel": {
    "file_icons": true,
  },
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true
  },
  "wrap_guides": [
    80,
    100,
    120
  ],
}
