// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "agent_buffer_font_size": 15.0,
  "buffer_line_height": "comfortable",
  "use_smartcase_search": true,
  "search": {
    "case_sensitive": true
  },
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "dock": "right"
  },
  "ssh_connections": [
    {
      "host": "staging-01",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/ubuntu/containers"
          ]
        },
        {
          "paths": [
            "/opt/stacks"
          ]
        }
      ]
    },
    {
      "host": "staging-02",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/ubuntu"
          ]
        }
      ]
    },
    {
      "host": "10.10.0.101",
      "args": [],
      "projects": [
        {
          "paths": [
            "/opt/dockge"
          ]
        }
      ]
    },
    {
      "host": "10.10.0.103",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/admin"
          ]
        }
      ]
    },
    {
      "host": "10.10.0.110",
      "args": [],
      "projects": []
    },
    {
      "host": "10.10.0.120",
      "args": [],
      "projects": []
    },
    {
      "host": "hostinger-b1",
      "args": [],
      "projects": [
        {
          "paths": []
        }
      ]
    }
  ],
  "agent": {
    "message_editor_min_lines": 3,
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        }
      },
      "default": "confirm"
    },
    "default_profile": "ask",
    "use_modifier_to_send": true,
    "dock": "left",
    "default_model": {
      "provider": "google",
      "model": "gemini-3-flash-preview"
    }
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "plan",
        "model": "opencode/deepseek-v4-flash-free"
      },
      "type": "registry"
    },
    "kilo": {
      "default_config_options": {
        "mode": "plan",
        "model": "kilo/kilo-auto/free"
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 15.0,
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "default_minimum_tokens": "10000"
      }
    },
    "mcp-server-sequential-thinking": {
      "settings": {}
    }
  },
  "debugger": {
    // "dock": "left",
  },
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [
      "**/*.log",
      "**/*.old"
    ],
    "mode": "subtle"
  },
  // File scan exclusions, hide on the file explorer and search
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // above is default from Zed
    "**/out",
    "**/.husky",
    "**/.next",
    "**/.nyc_output",
    "**/.pnpm-store",
    "**/.storybook",
    "**/.tap",
    "**/.turbo"
  ],
  "file_types": {
    "Blade": [
      "*.blade.php"
    ],
    "JSONC": [
      ".devcontainer/*/devcontainer.json",
      ".devcontainer/devcontainer.json",
      ".devcontainer.json",
      "tsconfig.*.json",
      "**/.zed/**/*.json",
      "**/zed/**/*.json",
      "**/Zed/**/*.json",
      "**/.vscode/**/*.json"
    ],
    "Nginx": [
      "*/nginx/**.conf"
    ],
    "env": [
      ".env",
      ".env.*"
    ],
    "tmux": [
      ".tmux.conf",
      "tmux.conf"
    ]
  },
  "formatter": "language_server",
  "format_on_save": "off",
  "git_panel": {
    "file_icons": true,
    "status_style": "icon",
    "dock": "right"
  },
  "icon_theme": "Catppuccin Frappé",
  "inlay_hints": {
    "enabled": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "project_panel": {
    "git_status_indicator": true,
    "button": true,
    "dock": "right",
    "git_status": true
  },
  "languages": {
    "PHP": {
      "language_servers": ["intelephense", "!phptools", "!phpactor", "..."]
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx"],
        "experimental": {
          "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"]
        }
      }
    },
    "json-language-server": {
      "settings": {
        "json": {
          "schemas": [
            {
              "fileMatch": [".gemini/settings.json", "gemini/settings.json"],
              "url": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/schemas/settings.schema.json"
            },
            {
              "fileMatch": [".devcontainer/*/devcontainer.json", ".devcontainer/devcontainer.json", ".devcontainer.json"],
              "url": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.base.schema.json"
            },
            {
              "fileMatch": ["*/composer.json", ".composer.json"],
              "url": "https://getcomposer.org/schema.json"
            },
            {
              "fileMatch": ["deno.json", "deno.jsonc"],
              "url": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json"
            }
          ]
        }
      }
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemas": {}
        }
      }
    },
    "lua-language-server": {},
    "vtsls": {
      "settings": {
        // Add vue.js integration
        // See https://github.com/zed-extensions/vue/issues/6#issuecomment-2739514942
        "vtsls": {
          "experimental": {
            // https://github.com/zed-industries/zed/issues/13317#issuecomment-2646080375
            "maxInlayHintLength": 25
          },
          "tsserver": {
            "globalPlugins": [
              {
                "name": "@vue/typescript-plugin",
                "location": "/opt/homebrew/lib/node_modules",
                "enableForWorkspaceTypeScriptVersions": true
              }
            ]
          }
        },
        // For TypeScript:
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 4096
          }
        },
        // For JavaScript:
        "javascript": {
          "tsserver": {
            "maxTsServerMemory": 4096
          }
        }
      }
    }
  },
  "terminal": {
    "button": false,
    "detect_venv": {
      "on": {
        "directories": [
          "env",
          ".venv",
          "venv"
        ],
        "activate_script": "default"
      }
    }
  },
  "theme": "Ayu Dark",
  "ui_font_family": "FiraCode Nerd Font",
  "ui_font_size": 15.0,
  "wrap_guides": [
    80,
    100,
    120
  ],
  "vim_mode": true
}
