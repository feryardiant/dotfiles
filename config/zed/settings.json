// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "auto_compact": {
      "threshold": "90%"
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "openrouter",
      "model": "~deepseek/deepseek-v4-flash-latest",
      "enable_thinking": true
    },
    "favorite_models": [],
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash-latest",
      "enable_thinking": false
    },
    "model_parameters": [],
    "sandbox_permissions": {
      "network_hosts": [
        "github.com",
        "api.github.com"
      ]
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\b"
            },
            {
              "pattern": "^echo\\b"
            }
          ]
        },
        "fetch": {
          "default": "allow"
        }
      }
    },
  },
  "agent_servers": {
    "OpenCode": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
    },
    "KiloCode": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "custom",
      "command": "kilo",
      "args": ["acp"],
    },
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "base_keymap": "VSCode",
  "use_smartcase_search": true,
  "buffer_font_family": "FiraCode Nerd Font Propo",
  "buffer_font_size": 14.0,
  "ui_font_family": "FiraCode Nerd Font",
  "ui_font_size": 15.0,
  "icon_theme": "Catppuccin Mocha",
  "file_types": {
    "Nginx": [
      "*/nginx/**.conf"
    ],
    "env": [
      ".env",
      ".env.*"
    ],
    "tmux": [
      ".tmux.conf",
      "tmux.conf"
    ]
  },
  "git_panel": {
    "file_icons": true,
  },
  "languages": {
    "PHP": {
      "language_servers": ["phpantom", "!intelephense", "!phptools", "!phpactor", "..."]
    },
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "oxfmt": {},
    "oxlint": {},
    "eslint": {},
    "astro-language-server": {},
    "svelte-language-server": {},
    "vue-language-server": {},
    "tailwindcss-language-server": {},
    "typescript-language-server": {},
    "vtsls": {
      "settings": {
        // Add vue.js integration
        // See https://github.com/zed-extensions/vue/issues/6#issuecomment-2739514942
        "vtsls": {
          "experimental": {
            // https://github.com/zed-industries/zed/issues/13317#issuecomment-2646080375
            "maxInlayHintLength": 25
          },
          // "tsserver": {
          //   "globalPlugins": [
          //     {
          //       "name": "@vue/typescript-plugin",
          //       "location": "/opt/homebrew/lib/node_modules",
          //       "enableForWorkspaceTypeScriptVersions": true
          //     }
          //   ]
          // }
        },
        // For TypeScript:
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 4096
          }
        },
        // For JavaScript:
        "javascript": {
          "tsserver": {
            "maxTsServerMemory": 4096
          }
        }
      }
    },
    "json-language-server": {
      "settings": {
        "json": {
          "schemas": [
            {
              "fileMatch": [".gemini/settings.json", "gemini/settings.json"],
              "url": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/schemas/settings.schema.json"
            },
            {
              "fileMatch": [".devcontainer/*/devcontainer.json", ".devcontainer/devcontainer.json", ".devcontainer.json"],
              "url": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.base.schema.json"
            },
            {
              "fileMatch": ["*/composer.json", ".composer.json"],
              "url": "https://getcomposer.org/schema.json"
            },
            {
              "fileMatch": ["deno.json", "deno.jsonc"],
              "url": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json"
            }
          ]
        }
      }
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemas": {}
        }
      }
    },
    "lua-language-server": {},
  },
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true
  },
  "wrap_guides": [
    80,
    100,
    120
  ],
}
