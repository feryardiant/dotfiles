{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "lsp": {
    "php": {
      "command": ["phpantom_lsp", "--stdio"],
      "extensions": [".php"]
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "disabled": false,
        "command": ["chrome-devtools-mcp"],
        "environment": {
          "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
        }
      },
      "context7": {
        "type": "local",
        "disabled": true,
        "command": ["npx", "-y", "@upstash/context7-mcp"],
      },
      "context-mode": {
        "type": "local",
        "disabled": true,
        "command": ["context-mode"],
      },
      "dbx": {
        "type": "local",
        "disabled": true,
        "command": ["npx", "-y", "@dbx-app/mcp-server"]
      },
      "sequential-thinking": {
        "type": "local",
        "disabled": true,
        "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
      },
      "shadcn": {
        "type": "local",
        "disabled": true,
        "command": ["npx", "-y", "shadcn@latest", "mcp"]
      }
    },
  },
  "providers": {
    "9router": {
      "name": "9Router",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://10.10.0.100:20128/v1"
      },
      "models": {
      }
    }
  },
  "permissions": [],
  "plugins": [
    // "context-mode@git+https://github.com/mksglu/context-mode.git",
    // "ponytail@git+https://github.com/DietrichGebert/ponytail.git",
    "~/.local/share/obra-superpowers",
  ]
}
