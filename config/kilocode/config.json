{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kilo/kilo-auto/free",
  "instructions": [
    "/Users/fery/Config/dotfiles/config/ai/instructions/global.md"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "context7-mcp"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "mcp-server-sequential-thinking"
      ]
    },
    "everything": {
      "type": "local",
      "enabled": true,
      "command": [
        "mcp-server-everything"
      ]
    },
    "shadcn": {
      "type": "local",
      "enabled": true,
      "command": [
        "shadcn-mcp"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "chrome-devtools-mcp"
      ]
    }
  },
  "permission": {
    "bash": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "question": "allow",
    "read": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
