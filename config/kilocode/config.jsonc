{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kilo/kilo-auto/free",
  "instructions": [
    "/Users/fery/Config/dotfiles/config/agents/global-instructions.md"
  ],
  "lsp": {
    "php": {
      "command": ["phpantom_lsp", "--stdio"],
      "extensions": [".php"]
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": ["chrome-devtools-mcp"],
      "environment": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      }
    },
    "context7": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "@upstash/context7-mcp"],
    },
    "context-mode": {
      "type": "local",
      "enabled": true,
      "command": ["context-mode"],
    },
    "dbx": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "@dbx-app/mcp-server"]
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "shadcn": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "shadcn@latest", "mcp"]
    }
  },
  "permission": {
    "bash": "allow",
    "context-mode_ctx_fetch_and_index": {
      "*": "allow"
    },
    "context-mode_ctx_search": {
      "*": "allow"
    },
    "read": {
      "*": "allow"
    }
  },
  "plugin": [
    "context-mode@git+https://github.com/mksglu/context-mode.git",
    "ponytail@git+https://github.com/DietrichGebert/ponytail.git",
    // "superpowers@git+https://github.com/obra/superpowers.git",
  ],
  "provider": {}
}
